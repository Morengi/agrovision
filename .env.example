# PostgreSQL
POSTGRES_USER=agrovision
POSTGRES_PASSWORD=agrovision
POSTGRES_DB=agrovision

# Backend (app/core/config.py)
DEBUG=true
DATABASE_URL=postgresql+asyncpg://agrovision:agrovision@db:5432/agrovision
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
MEDIA_ROOT=media
CORS_ORIGINS=["http://localhost:5173"]

# Seed script (backend/app/seed.py) — set these before first seeding so the
# admin/moderator/student accounts aren't created with a guessable password.
SEED_ADMIN_PASSWORD=change-me-admin
SEED_MODERATOR_PASSWORD=change-me-moderator
SEED_STUDENT_PASSWORD=change-me-student

# Outgoing email (password reset). Leave SMTP_HOST empty to log emails to the
# backend console instead of sending them (dev default). FRONTEND_URL is used
# to build the link inside the reset-password email.
FRONTEND_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@agrovision.ru
SMTP_USE_TLS=true

# Frontend
VITE_API_PROXY_TARGET=http://backend:8000
